FIREBASE_PROJECT_ID=ultranet-e94aa
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# שליחת דו"ח ההתחשבנות החודשי לסניפים (lib/mailer.ts).
# בלי אלה התצוגה המקדימה של הדו"ח עובדת, אבל כפתור השליחה יגיד שחסרה הגדרה.
RESEND_API_KEY=
# רשות. בלי הערך הזה נשלח מכתובת הבדיקה של Resend (onboarding@resend.dev), שמגיעה
# רק לכתובת שאיתה נרשמת ל-Resend - מספיק לבדיקה עצמית, לא לשליחה לשותפים.
# לשליחה אמיתית: אמת דומיין ב-Resend ושים כאן למשל: אולטרנט <reports@your-domain.co.il>
REPORT_FROM_EMAIL=

# השליחה האוטומטית של הדו"ח החודשי הושבתה (2026-10) - שולחים ידנית ממסך "ניידים".
# המשתנה REPORTS_CRON_SECRET כבר לא בשימוש.

# ייבוא הכנסות חודשיות מאקסל להנה"ח של סניף חדר מחשבים
# (/dashboard/computer-rooms-accounting/[id]). זהו כלי זמני למילוי היסטוריה.
# ברירת המחדל דלוקה; כשמילוי ההיסטוריה יסתיים שים כאן off - הכפתורים ייעלמו מהמסך
# וגם ה-Server Action וה-API של התבנית יסרבו לפעול.
BRANCH_INCOME_IMPORT=on


# מרכז העזרה (/dashboard/help) — עוזר חכם שעונה על שאלות "איך עושים".
# אופציונלי: בלי מפתח, מרכז העזרה עונה מתוך השאלות הנפוצות בלבד.
ANTHROPIC_API_KEY=
