# שליחת דו"ח ההתחשבנות החודשי לסניפים (lib/mailer.ts).
# בלי אלה התצוגה המקדימה של הדו"ח עובדת, אבל כפתור השליחה יגיד שחסרה הגדרה.
RESEND_API_KEY=
# רשות. בלי הערך הזה נשלח מכתובת הבדיקה של Resend (onboarding@resend.dev), שמגיעה
# רק לכתובת שאיתה נרשמת ל-Resend - מספיק לבדיקה עצמית, לא לשליחה לשותפים.
# לשליחה אמיתית: אמת דומיין ב-Resend ושים כאן למשל: אולטרנט <reports@your-domain.co.il>
REPORT_FROM_EMAIL=

# שליחה אוטומטית של הדו"ח החודשי (POST /api/rentals/monthly-reports).
# בלי המפתח הזה הנתיב מסרב לפעול בכלל. שלח אותו ככותרת: Authorization: Bearer <הערך>
